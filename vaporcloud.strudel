samples('github:tidalcycles/dirt-samples')
setcpm(100/4)

// 7 slots per cycle against 8-step drums — phrases that don't resolve
let riffA = "f#4 [a4 c#5] e5 ~ [c#5 b4] ~ ~"
let riffB = "~ [f#4 a4] c#5 e5 ~ [c#5 b4] ~"
let riffC = "[e4 f#4] ~ a4 c#5 ~ b4 ~"
let riffD = "f#4 [a4 c#5] [e5 f#5] ~ [c#5 b4] ~ ~"

let riff = "<0 1 0 2 0 1 3 1>".pick([riffA, riffB, riffC, riffD])

// tape wobble — one drift source, shared by every melodic layer
let wobble = perlin.range(-.11,.11).slow(13)

let calm  = "<1 1 1 1 0 0 0 0>".slow(2)
let heavy = "<0 0 0 0 1 1 1 1>".slow(2)

stack(
  // --- INTRO: dry-ish, nervous, the riff alone ---
  note(riff).add(note(wobble))
    .sound("triangle").attack(.005).decay(.35).sustain(0)
    .lpf(2400).gain(.4)
    .room(.65).size(7).pan(.42)
    .superimpose(x => x.add(note(7)).gain(.11).late(.125).pan(.65))
    .mask(calm),

  note(riff).add(note(-12))
    .struct("t ~ ~ t ~ ~ t")
    .sound("sine").attack(.01).release(.7).gain(.32)
    .mask(calm),

  s("~ ~ rim ~ ~ ~ ~ rim")
    .bank("RolandTR909").gain(.28)
    .speed(.85).room(.75).size(8)
    .mask(calm),

  // --- SUBMERSION ---
  s("bd ~ ~ ~ ~ bd ~ ~")
    .bank("RolandTR909").gain(1.15).lpf(400).shape(.4).room(.3)
    .mask(heavy),

  // clap smeared into its own reverb bus
  s("~ ~ ~ ~ cp ~ ~ ~")
    .bank("RolandTR909").gain(.65).crush(8)
    .speed(.8).room(.9).size(10).orbit(2)
    .mask(heavy),

  s("hh*8").bank("RolandTR909")
    .speed(.85)
    .gain(sine.range(.13,.3).slow(6))
    .degradeBy(sine.range(.3,.65).slow(8))
    .pan(perlin.range(.25,.75))
    .mask(heavy),

  // riff answers an octave down — blurred stabs, not stabs
  note(riff).add(note(-12)).add(note(wobble))
    .struct("t ~ t ~ ~ t ~")
    .sound("square")
    .add(note("0,.08"))
    .attack(.02).decay(.4).sustain(0).release(.5)
    .lpf(perlin.range(500,1500).slow(20)).lpq(3)
    .gain(.3).shape(.2)
    .room(.9).size(9).pan(.55)
    .delay(.35).delaytime(.5).delayfeedback(.4)
    .mask(heavy),

  // sub, slow and heavy
  note("<f#1 f#1 d1 c#1>")
    .struct("t ~ ~ ~ t ~ ~ ~")
    .sound("sine").attack(.02).release(1.4)
    .gain(.95).shape(.25)
    .mask(heavy),

  // vocal-as-texture in the slot the lead used to occupy
  s("space").fit().chop(6)
    .speed(.55).gain(.15)
    .lpf(1500).crush(8)
    .room(.9).size(10).orbit(2)
    .degradeBy(.55)
    .sometimesBy(.2, x => x.rev())
    .mask(heavy.mask("<0 1 1 0 1 1 0 1>".slow(2))),

  // pad, both halves, wobbling with everything else
  note("<[f#3,a3,c#4] [d3,f#3,a3] [c#3,e3,g#3] [d3,a3,d4]>")
    .add(note(wobble))
    .sound("sawtooth").attack(3).release(4)
    .gain(.11).lpf(750).room(.95).size(12)
)