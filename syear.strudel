// suicideyear × radiocore × atmosferic drift
setcps(0.8) // ~72 bpm, halftime

// 909 drowned — heavy kick, snare far back in the room
const bateria = stack(
  s("bd ~ ~ ~ ~ ~ bd ~").bank("RolandTR909")
    .gain(1).shape(0.45)
    .lpf(perlin.range(500,1600).slow(19)),
  s("~ ~ ~ ~ sd ~ ~ ~").bank("RolandTR909")
    .gain(0.65).room(0.85).size(0.9).orbit(2)
    .sometimesBy(0.15, x => x.ply(3).gain(0.25)),
  s("hh*8").bank("RolandTR909")
    .gain(sine.range(0.12,0.4).fast(3))
    .pan(perlin.range(0.25,0.75))
    .degradeBy(0.4)
    .mask("<1 1 1 0>/2"),
  s("~ ~ oh ~").bank("RolandTR909")
    .gain(0.2).room(0.6).degradeBy(0.65)
)

// 808-ish sub in sine, with a slide into the note
const sub = note("<f1 f1 db1 ab1>")
  .s("sine")
  .penv(-3).pattack(0.12).pcurve(1)
  .attack(0.01).decay(0.9).sustain(0.35).release(0.5)
  .gain(0.85).shape(0.3).lpf(120)

// radiocore plucks: 5-note figure over 8 slots, saw + perlin sweep
const plucks = note("{f3 ab3 c4 eb4 bb3}%8")
  .s("sawtooth")
  .cutoff(perlin.range(300,2600).slow(23))
  .resonance(14)
  .attack(0.005).decay(0.14).sustain(0).release(0.1)
  .gain(0.45)
  .room(0.5).size(0.7)
  .delay(0.4).delaytime(0.1875).delayfeedback(0.55)
  .pan(perlin.range(0.3,0.7).slow(7))
  .sometimesBy(0.18, x => x.ply(2).gain(0.3))
  .every(6, x => x.rev())
  .mask("<1 1 1 1 1 0 1 1>/4")

// pad: vowel filter so it reads as voice-texture, not as a voice
const pad = note("<[f2,ab2,c3,eb3] [db2,f2,ab2,c3] [ab2,c3,eb3,g3] [eb2,g2,bb2,db3]>")
  .s("supersaw").spread(0.6)
  .attack(2).release(4).sustain(0.8)
  .cutoff(sine.range(350,1100).slow(31))
  .vowel("<a o e u>/2")
  .gain(0.32).room(0.9).size(0.95).orbit(3)
  .slow(2)

stack(bateria, sub, plucks, pad).postgain(0.9)