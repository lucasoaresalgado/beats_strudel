samples('github:tidalcycles/dirt-samples')

setcpm(75/4)

// dirtcloud — mesma engenharia do vaporcloud, puxada pro lado BONES:
// meio tempo, 808 estourado, loop curto que não anda, tudo com terra.
//   - 8 slots (não 7): o loop é quadrado de propósito, hipnótico
//   - reverb menor, distorção/crush maiores: sujo e perto, não nuvem
//   - a variação vem do arranjo (seções), não da melodia

// E frígio — b3 c4 d4 e4 f4 g4 — o meio-tom c-b é a assinatura
let riffA = "e4 ~ [g4 f4] ~ e4 ~ [b3 c4] ~"
let riffB = "e4 ~ [g4 f4] ~ [d4 c4] ~ b3 ~"
let riffC = "e4 ~ g4 [f4 e4] ~ c4 ~ [b3 c4]"
let riffD = "[e4 g4] ~ f4 ~ e4 [c4 b3] ~ ~"
let riff = "<0 0 1 0 0 2 1 3>".pick([riffA, riffB, riffC, riffD])

// wow & flutter de fita — uma fonte só, compartilhada
let wow = perlin.range(-.16,.16).slow(11)

// arranjo em 16 ciclos
let intro = "<1 1 1 0 0 0 0 0>".slow(2)
let full  = "<0 0 0 1 1 1 1 1>".slow(2)
let murk  = "<0 0 0 0 0 1 1 1>".slow(2)

stack(

  // --- ruído de fita / vinil: cola tudo, nunca sai ---
  s("pink*2").gain(.055).lpf(5200).hpf(180)
    .room(.25).pan(sine.range(.4,.6).slow(17)),

  // --- INTRO: o loop sozinho, seco, meio desafinado ---
  note(riff).add(note(wow))
    .sound("sawtooth")
    .add(note("0,.13"))                 // detune: duas cordas quase juntas
    .attack(.004).decay(.28).sustain(0)
    .lpf(1700).lpq(4).gain(.34)
    .crush(7).shape(.28)
    .room(.4).size(4).pan(.46)
    .mask(intro),

  s("~ ~ rim ~ ~ ~ ~ [rim rim]")
    .bank("RolandTR808").gain(.3)
    .speed(.9).crush(6).room(.35)
    .mask(intro),

  // --- CORPO: mesma frase, uma oitava abaixo, embaçada ---
  note(riff).add(note(-12)).add(note(wow))
    .sound("square")
    .add(note("0,.1"))
    .attack(.01).decay(.45).sustain(0).release(.5)
    .lpf(perlin.range(420,1300).slow(19)).lpq(5)
    .gain(.3).shape(.35).crush(6)
    .room(.55).size(6).pan(.54)
    .delay(.28).delaytime(.375).delayfeedback(.42)
    .mask(full),

  // --- 808: nota longa, saturada até a cabeça ---
  note("<e1 e1 c1 b0 e1 e1 g0 c1>")
    .struct("t ~ ~ [~ t] t ~ ~ ~")
    .sound("sine").attack(.008).release(1.6)
    .gain(1.05).shape(.55).lpf(160)
    .mask(full),

  // camada de distorção do 808 (o grão que o sine puro não tem)
  note("<e2 e2 c2 b1 e2 e2 g1 c2>")
    .struct("t ~ ~ [~ t] t ~ ~ ~")
    .sound("sawtooth").attack(.008).release(1.1)
    .gain(.16).lpf(500).crush(5).shape(.5)
    .mask(full),

  // --- kick curto: só marca, quem sustenta é o 808 ---
  s("bd ~ ~ [~ bd] bd ~ ~ ~")
    .bank("RolandTR808").gain(.9).lpf(320).shape(.45)
    .mask(full),

  // --- caixa em meio tempo, arrastada pro próprio reverb ---
  s("~ ~ ~ ~ cp ~ ~ ~")
    .bank("RolandTR808").gain(.6)
    .speed(.82).crush(5).shape(.3)
    .room(.6).size(6).orbit(2)
    .mask(full),

  // --- hats: rolos ocasionais, não groove de trap limpo ---
  s("hh*8").bank("RolandTR808")
    .speed(.92)
    .gain(sine.range(.11,.26).slow(7))
    .sometimesBy(.22, x => x.ply(2).gain(.13))
    .rarely(x => x.ply(3).speed(1.1))
    .degradeBy(sine.range(.15,.45).slow(9))
    .pan(perlin.range(.3,.7))
    .mask(full),

  // --- MURK: sample de guitarra picotado, o "sample sujo" da faixa ---
  s("gtr").fit().chop(8)
    .speed(.62).gain(.13)
    .lpf(1400).hpf(200).crush(6)
    .room(.7).size(8).orbit(2)
    .degradeBy(.5)
    .sometimesBy(.25, x => x.rev())
    .sometimesBy(.15, x => x.speed(.31))
    .mask(murk),

  // --- drone: acorde parado embaixo de tudo ---
  note("<[e2,b2,e3] [e2,b2,e3] [c2,g2,c3] [b1,f#2,b2]>")
    .add(note(wow))
    .sound("sawtooth").attack(2.5).release(3.5)
    .gain(.09).lpf(600).lpq(2)
    .room(.8).size(9)
)
